<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- تنظیمات نوگت (publish با dotnet pack) -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageId>HosseinVatankhah.PersianDatePicker.Blazor</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hossein Vatankhah</Authors>
    <Description>A lightweight and powerful Persian (Jalali) Datepicker component for Blazor WebAssembly and Server.</Description>
    <PackageTags>blazor;datepicker;persian;jalali;shamsi;calendar</PackageTags>
    <PackageProjectUrl>https://github.com/hosseinvatankhah0/persian-date-picker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hosseinvatankhah0/persian-date-picker</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

</Project>
